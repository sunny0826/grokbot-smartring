# Minimal configuration required by the SmartRing-Plus BSP (see BSP README)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_LV_USE_CLIB_MALLOC=y
# Animation rendering is CPU-hungry; enable performance optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The BSP's 250Hz IMU sampling task uses pdMS_TO_TICKS(4), which would assert to 0 at 100Hz ticks
CONFIG_FREERTOS_HZ=1000
# Measured 16MB flash on this unit
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Public CA bundle + WSS exceeds the original 1500K app partition.
# Keep the verified on-device NVS and phy offsets, enlarge only factory.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Reserve internal RAM for display DMA and the Wi-Fi/TLS stack:
# movable .bss goes to PSRAM, Wi-Fi static RX pool shrinks to 4 (the gadget
# protocol is 200 ms polls of ≤2 KB frames — a small pool is plenty), and the
# LAN link is IPv4-only.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_LWIP_IPV6=n
# IRAM and DRAM share the same physical SRAM banks on the S3: pushing the Wi-Fi
# and lwIP hot paths back to flash leaves more DRAM for DMA and networking.
CONFIG_ESP32_WIFI_IRAM_OPT=n
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# The gadget protocol owns the USB Serial/JTAG port (LF-delimited JSON); the
# secondary console would corrupt the frame stream. Logs stay on UART0 (primary).
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Both LAN and public TLS validate certificate validity dates after SNTP.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_WS_TRANSPORT=y
# Required to suppress the IDF WS Upgrade-error log that contains auth headers.
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y

# Nearby SSIDs can contain Chinese; setup labels use a larger generated subset.
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_USE_QRCODE=y
